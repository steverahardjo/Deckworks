{
  "info": {
    "name": "Deckworks Remote API",
    "_postman_id": "deckworks-remote-auth",
    "description": "Auth API surface for the Deckworks remote FastAPI backend. Run `uv run uvicorn remote.main:app --reload` first, import this collection + environment, then start with **Auth → Register** (sets your token).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"name\": \"{{name}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.environment.set(\"access_token\", body.access_token);",
                  "pm.environment.set(\"refresh_token\", body.refresh_token);",
                  "pm.test(\"register returns token pair\", () => {",
                  "  pm.expect(pm.response.code).to.equal(201);",
                  "  pm.expect(body.access_token).to.not.be.empty;",
                  "  pm.expect(body.refresh_token).to.not.be.empty;",
                  "  pm.expect(body.user.email).to.eql(pm.environment.get(\"email\"));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.environment.set(\"access_token\", body.access_token);",
                  "pm.environment.set(\"refresh_token\", body.refresh_token);",
                  "pm.test(\"login returns token pair\", () => {",
                  "  pm.expect(pm.response.code).to.equal(200);",
                  "  pm.expect(body.access_token).to.not.be.empty;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Refresh",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/auth/refresh", "host": ["{{baseUrl}}"], "path": ["auth", "refresh"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"refresh rotates the token pair\", () => {",
                  "  pm.expect(pm.response.code).to.equal(200);",
                  "  pm.environment.set(\"access_token\", pm.response.json().access_token);",
                  "  pm.environment.set(\"refresh_token\", pm.response.json().refresh_token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/auth/logout", "host": ["{{baseUrl}}"], "path": ["auth", "logout"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"logout returns 204\", () => pm.expect(pm.response.code).to.equal(204));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"me returns current user\", () => {",
                  "  pm.expect(pm.response.code).to.equal(200);",
                  "  pm.expect(pm.response.json().email).to.eql(pm.environment.get(\"email\"));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Forgot password",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/auth/forgot-password", "host": ["{{baseUrl}}"], "path": ["auth", "forgot-password"] }
          }
        },
        {
          "name": "Reset password",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"<reset token from server log>\",\n  \"new_password\": \"{{new_password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/auth/reset-password", "host": ["{{baseUrl}}"], "path": ["auth", "reset-password"] }
          }
        },
        {
          "name": "Request verification",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/auth/request-verification", "host": ["{{baseUrl}}"], "path": ["auth", "request-verification"] }
          }
        },
        {
          "name": "Verify email",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"<verify token from server log>\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/auth/verify", "host": ["{{baseUrl}}"], "path": ["auth", "verify"] }
          }
        },
        {
          "name": "OAuth authorize - GitHub",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/auth/oauth/github/authorize", "host": ["{{baseUrl}}"], "path": ["auth", "oauth", "github", "authorize"] }
          }
        },
        {
          "name": "OAuth authorize - Google",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/auth/oauth/google/authorize", "host": ["{{baseUrl}}"], "path": ["auth", "oauth", "google", "authorize"] }
          }
        },
        {
          "name": "OAuth callback",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/oauth/github/callback?code=CODE&state=STATE",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "oauth", "github", "callback"],
              "query": [
                { "key": "code", "value": "CODE" },
                { "key": "state", "value": "STATE" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Shared assets (public)",
      "item": [
        {
          "name": "Get presets",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/presets", "host": ["{{baseUrl}}"], "path": ["presets"] }
          }
        },
        {
          "name": "Get skill",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/skills/{{skill_name}}",
              "host": ["{{baseUrl}}"],
              "path": ["skills", "{{skill_name}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Projects (protected)",
      "item": [
        {
          "name": "Create project",
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseUrl}}/projects", "host": ["{{baseUrl}}"], "path": ["projects"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"create project returns projectId\", () => {",
                  "  pm.expect(pm.response.code).to.equal(201);",
                  "  pm.expect(pm.response.json().projectId).to.not.be.empty;",
                  "  pm.environment.set(\"projectId\", pm.response.json().projectId);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get deck",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/projects/{{projectId}}/deck", "host": ["{{baseUrl}}"], "path": ["projects", "{{projectId}}", "deck"] }
          }
        },
        {
          "name": "Update deck",
          "request": {
            "method": "PUT",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slides\": [\n    {\n      \"id\": \"s1\",\n      \"title\": \"Quarterly Business Review\",\n      \"subtitle\": \"Q2 FY2026 · Product & GTM\"\n    }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/projects/{{projectId}}/deck", "host": ["{{baseUrl}}"], "path": ["projects", "{{projectId}}", "deck"] }
          }
        },
        {
          "name": "Add comment",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"comment\": \"Make the title bolder\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/projects/{{projectId}}/comments", "host": ["{{baseUrl}}"], "path": ["projects", "{{projectId}}", "comments"] }
          }
        },
        {
          "name": "Compile (501)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slides\": []\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/projects/{{projectId}}/compile", "host": ["{{baseUrl}}"], "path": ["projects", "{{projectId}}", "compile"] }
          }
        },
        {
          "name": "Export (501)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"format\": \"html\",\n  \"presentation\": {}\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/projects/{{projectId}}/export", "host": ["{{baseUrl}}"], "path": ["projects", "{{projectId}}", "export"] }
          }
        },
        {
          "name": "Run code (501)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"print('hello from sandbox')\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/projects/{{projectId}}/run", "host": ["{{baseUrl}}"], "path": ["projects", "{{projectId}}", "run"] }
          }
        }
      ]
    }
  ]
}
