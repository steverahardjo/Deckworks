# Deckworks remote backend — auth config
# Copy to .env and fill in real values. All keys are optional for local dev
# (a random-feeling dev secret is the only fallback; OAuth providers 503 until configured).

# JWT signing secret (>= 32 chars). REQUIRED in production.
AUTH_JWT_SECRET=change-me-to-a-long-random-string

# Public base URL of this service — used to build OAuth redirect URIs.
AUTH_BASE_URL=http://localhost:8000

# Token lifetimes (seconds)
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000

# GitHub OAuth app (Settings → Developer settings → OAuth Apps)
AUTH_OAUTH_GITHUB_CLIENT_ID=
AUTH_OAUTH_GITHUB_CLIENT_SECRET=

# Google OAuth app (Credentials → OAuth client ID, type "Web application")
AUTH_OAUTH_GOOGLE_CLIENT_ID=
AUTH_OAUTH_GOOGLE_CLIENT_SECRET=
