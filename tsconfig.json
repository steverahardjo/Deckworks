{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    "baseUrl": ".",
    "paths": {
      "@/*": ["./apps/local-frontend/src/*"],
      "@deckworks/core": ["./packages/core/src/index.ts"],
      "@deckworks/core/store": ["./packages/core/src/store.ts"],
      "@deckworks/export": ["./packages/export/src/index.ts"],
      "@deckworks/export/html": ["./packages/export/src/exportHtml.ts"],
      "@deckworks/export/pdf": ["./packages/export/src/exportPdf.tsx"],
      "@deckworks/export/ops": ["./packages/export/src/ops.ts"]    },

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  },

  "exclude": ["dist", "node_modules"]
}
